# Set this to the email address that should access /admin.
ADMIN_EMAIL=owner@example.com

# Use a long random string in production.
SESSION_SECRET=replace-with-a-long-random-secret

# Keep this directory on persistent storage when deployed.
DATABASE_PATH=./data/pixel-mural.sqlite

# Optional: external virtual-goods purchase page. The current pattern slug is appended as ?pattern=...
# PURCHASE_BASE_URL=https://your-virtual-goods-store.example.com/buy
